# Provider-neutral LLM configuration. The provider is selected by the server,
# never by public job input.
AIVS_LLM_PROVIDER=minimax-h3
AIVS_LLM_BASE_URL=http://127.0.0.1:3001/v1
AIVS_LLM_API_KEY=replace-with-local-secret
AIVS_LLM_MODEL=MiniMax-H3

# Optional OpenAI-compatible speech endpoint. Leave empty to use the offline
# silent audio fallback for local demos.
AIVS_TTS_BASE_URL=
AIVS_TTS_API_KEY=
AIVS_TTS_MODEL=

# Optional generic asynchronous video adapter. Vendor-specific directories can
# subclass this transport when their submit/poll response differs.
AIVS_VIDEO_PROVIDER=
AIVS_VIDEO_BASE_URL=
AIVS_VIDEO_API_KEY=
AIVS_VIDEO_MODEL=
AIVS_VIDEO_SUBMIT_PATH=/videos/generations
AIVS_VIDEO_POLL_PATH=/videos/{job_id}
AIVS_VIDEO_ALLOWED_DOWNLOAD_HOSTS=
AIVS_VIDEO_POLL_INTERVAL_SECONDS=2
AIVS_VIDEO_MAX_WAIT_SECONDS=300

# Runtime limits and storage. Filesystem is the offline/local default. Set
# AIVS_STORAGE_BACKEND=redis for a multi-process API/worker deployment.
AIVS_STORAGE_BACKEND=filesystem
AIVS_STORAGE_ROOT=.aivs
AIVS_REDIS_URL=redis://127.0.0.1:6379/0
AIVS_REDIS_NAMESPACE=aivs

# HTTP boundary. Empty API key keeps localhost development anonymous. Set a
# long random value before exposing /v1 or the dashboard through a proxy.
AIVS_API_KEY=
AIVS_RATE_LIMIT_PER_MINUTE=120
AIVS_RATE_LIMIT_WINDOW_SECONDS=60
AIVS_DEFAULT_DURATION_SECONDS=60
AIVS_MAX_DURATION_SECONDS=180
AIVS_PROVIDER_TIMEOUT_SECONDS=45

# File-queue policy. These values are service-owned and cannot be changed by
# public job input.
AIVS_JOB_MAX_ATTEMPTS=3
AIVS_JOB_LEASE_SECONDS=300
AIVS_JOB_RETRY_BACKOFF_SECONDS=5
