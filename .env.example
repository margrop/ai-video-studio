# Provider-neutral LLM configuration. The provider is selected by the server,
# never by public job input.
# Text planning model. This is separate from the MiniMax H3 video model.
AIVS_LLM_PROVIDER=minimax-llm
AIVS_LLM_BASE_URL=http://127.0.0.1:3001/v1
AIVS_LLM_API_KEY=replace-with-local-secret
AIVS_LLM_MODEL=minimax-latest

# Optional OpenAI-compatible speech endpoint. Leave empty to use the offline
# silent audio fallback for local demos.
AIVS_TTS_BASE_URL=
AIVS_TTS_API_KEY=
AIVS_TTS_MODEL=

# Optional generic asynchronous video adapter. Vendor-specific directories can
# subclass this transport when their submit/poll response differs.
AIVS_VIDEO_PROVIDER=
AIVS_VIDEO_BASE_URL=
AIVS_VIDEO_API_KEY=
AIVS_VIDEO_MODEL=
AIVS_VIDEO_SUBMIT_PATH=/videos/generations
AIVS_VIDEO_POLL_PATH=/videos/{job_id}
AIVS_VIDEO_ALLOWED_DOWNLOAD_HOSTS=
AIVS_VIDEO_POLL_INTERVAL_SECONDS=2
AIVS_VIDEO_MAX_WAIT_SECONDS=300

# Optional absolute path when PATH resolves to a minimal FFmpeg build.
# FFmpeg 8 drawtext requires libfreetype and libharfbuzz. On macOS install
# ffmpeg-full and use its keg-only binary explicitly.
# AIVS_FFMPEG_BINARY=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# Optional CJK-capable font. macOS ships PingFang at this path.
# AIVS_FONT_FILE=/System/Library/Fonts/PingFang.ttc

# Native MiniMax H3 video provider. Use the international or China API base
# URL appropriate for the Developer Platform account. H3 is asynchronous and
# the provider generates one 4–15 second Shot per request.
# AIVS_VIDEO_PROVIDER=minimax-video
# AIVS_MINIMAX_VIDEO_BASE_URL=https://api.minimax.io
# AIVS_MINIMAX_VIDEO_API_KEY=replace-with-minimax-developer-api-key
# AIVS_MINIMAX_VIDEO_MODEL=MiniMax-H3
# AIVS_MINIMAX_VIDEO_RESOLUTION=768P
# AIVS_MINIMAX_VIDEO_RATIO=9:16
# AIVS_MINIMAX_VIDEO_POLL_INTERVAL_SECONDS=10
# AIVS_MINIMAX_VIDEO_MAX_WAIT_SECONDS=900
# AIVS_MINIMAX_VIDEO_ALLOWED_DOWNLOAD_HOSTS=filecdn.minimax.chat
# Optional public URL template for Character/Asset references. The endpoint
# must be reachable by MiniMax without the AIVS API key.
# AIVS_ASSET_PUBLIC_URL_TEMPLATE=https://cdn.example.com/aivs/assets/{asset_id}

# Native Volcengine Ark Agent Plan video provider. Agent Plan requires its
# dedicated API key and the /api/plan/v3 base URL; a normal Ark/Coding Plan key
# must not be used here. The default model is the currently documented
# doubao-seedance-2.0 family. AIVS generates silent provider clips by default
# because the workflow adds its own narration track during FFmpeg composition.
# AIVS_VIDEO_PROVIDER=volcengine-agentplan-video
# AIVS_VOLCENGINE_VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# AIVS_VOLCENGINE_VIDEO_API_KEY=replace-with-agent-plan-api-key
# AIVS_VOLCENGINE_VIDEO_MODEL=doubao-seedance-2.0
# AIVS_VOLCENGINE_VIDEO_RESOLUTION=720p
# AIVS_VOLCENGINE_VIDEO_RATIO=9:16
# AIVS_VOLCENGINE_VIDEO_GENERATE_AUDIO=false
# AIVS_VOLCENGINE_VIDEO_WATERMARK=false
# Optional: first_frame, last_frame or reference_image. Empty follows Ark's
# default image-input behavior (the official example uses a first frame).
# AIVS_VOLCENGINE_VIDEO_REFERENCE_ROLE=
# AIVS_VOLCENGINE_VIDEO_POLL_INTERVAL_SECONDS=10
# AIVS_VOLCENGINE_VIDEO_MAX_WAIT_SECONDS=900
# AIVS_VOLCENGINE_VIDEO_ALLOWED_DOWNLOAD_HOSTS=ark-content-generation-cn-beijing.tos-cn-beijing.volces.com,ark-project.tos-cn-beijing.volces.com

# Other vendor scaffolds. Each prefix mirrors the generic VIDEO_* settings;
# verify the vendor contract before enabling.
# AIVS_KLING_VIDEO_BASE_URL=
# AIVS_VEO_VIDEO_BASE_URL=
# AIVS_RUNWAY_VIDEO_BASE_URL=
# AIVS_OPENAI_VIDEO_BASE_URL=

# Runtime limits and storage. Filesystem is the offline/local default. Set
# AIVS_STORAGE_BACKEND=redis for a multi-process API/worker deployment.
AIVS_STORAGE_BACKEND=filesystem
AIVS_STORAGE_ROOT=.aivs
AIVS_REDIS_URL=redis://127.0.0.1:6379/0
AIVS_REDIS_NAMESPACE=aivs
# Optional PostgreSQL metadata backend. Keep this server-side and configure
# AIVS_STORAGE_BACKEND=postgres only after the database is ready.
AIVS_POSTGRES_DSN=postgresql://aivs:aivs-dev-only@127.0.0.1:5432/aivs
# Leave these empty to follow AIVS_STORAGE_BACKEND. Set individually when
# queue, catalog, approval and audit lifecycles need different backends.
AIVS_CATALOG_BACKEND=
AIVS_APPROVAL_BACKEND=
AIVS_AUDIT_BACKEND=
# Explicit second gate for real external publishing. Keep false until a
# platform Publisher has been tested and human review is operational.
AIVS_EXTERNAL_PUBLISH_ENABLED=false

# Generated artifact storage. Filesystem is the default. Set backend=s3 for
# AWS S3, MinIO or another S3-compatible endpoint; install the s3 extra.
AIVS_ARTIFACT_BACKEND=filesystem
AIVS_S3_ENDPOINT_URL=
AIVS_S3_BUCKET=aivs
AIVS_S3_ACCESS_KEY_ID=
AIVS_S3_SECRET_ACCESS_KEY=
AIVS_S3_REGION=us-east-1
AIVS_S3_PREFIX=aivs

# HTTP boundary. Empty API key keeps localhost development anonymous. Set a
# long random value before exposing /v1 or the dashboard through a proxy.
AIVS_API_KEY=
AIVS_RATE_LIMIT_PER_MINUTE=120
AIVS_RATE_LIMIT_WINDOW_SECONDS=60
AIVS_DEFAULT_DURATION_SECONDS=60
AIVS_MAX_DURATION_SECONDS=180
AIVS_PROVIDER_TIMEOUT_SECONDS=45
AIVS_MAX_ASSET_BYTES=52428800
# Remote Article → Video sources are disabled unless every host is explicitly
# allowlisted (comma-separated, subdomains are accepted).
AIVS_SOURCE_ALLOWED_HOSTS=

# File-queue policy. These values are service-owned and cannot be changed by
# public job input.
AIVS_JOB_MAX_ATTEMPTS=3
AIVS_JOB_LEASE_SECONDS=300
AIVS_JOB_RETRY_BACKOFF_SECONDS=5
